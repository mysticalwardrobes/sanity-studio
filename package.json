{
  "name": "mysticalwardrobes",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "prom-queens:test": "tsx --test migrate/prom-queens/*.test.ts",
    "prom-queens:prepare": "sanity exec migrate/prom-queens/run.ts -- --prepare",
    "prom-queens:import": "sanity exec migrate/prom-queens/run.ts --with-user-token -- --apply",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/icons": "^5.2.1",
    "@sanity/vision": "^5.7.0",
    "react": "^19.1",
    "react-dom": "^19.1",
    "sanity": "^5.7.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1",
    "eslint": "^9.28",
    "prettier": "^3.5",
    "sharp": "^0.34.4",
    "typescript": "^5.8"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  }
}
